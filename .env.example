# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Required for Google Maps SDK.
MAPS_API_KEY=MY_MAPS_API_KEY

# OPENROUTESERVICE_API_KEY: Free routing and geocoding through OpenRouteService.
# Configure this in the build Secrets panel; never commit the real key.
OPENROUTESERVICE_API_KEY=MY_OPENROUTESERVICE_API_KEY

# GIPHY_API_KEY: Required for live GIFs and stickers search from Giphy.
# You can also change this securely in the AI Studio Secrets panel.
GIPHY_API_KEY=Sp8FgZ0UZm703LiBx3RutbdHH3q7XODd

# KLIPY_API_KEY: Required for live GIFs and stickers search from Klipy.
# You can also change this securely in the AI Studio Secrets panel.
KLIPY_API_KEY=vphHNolsolz
