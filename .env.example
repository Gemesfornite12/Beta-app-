# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GIPHY_API_KEY: Required for live GIFs and stickers search from Giphy.
# You can also change this securely in the AI Studio Secrets panel.
GIPHY_API_KEY=Sp8FgZ0UZm703LiBx3RutbdHH3q7XODd

# KLIPY_API_KEY: Required for live GIFs and stickers search from Klipy.
# You can also change this securely in the AI Studio Secrets panel.
KLIPY_API_KEY=vphHNolsolz
